{
  "name": "tecnofit-enxuto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/pre-start.mjs && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:apply": "node scripts/pre-start.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:prod": "node scripts/seed.prod.mjs",
    "demo:seed": "tsx scripts/seed-demo-only.ts",
    "demo:seed:prod": "node scripts/seed-demo.prod.mjs",
    "import:students": "tsx scripts/import-students.ts",
    "worker": "tsx src/workers/index.ts",
    "pilot:infra": "docker compose up -d postgres redis",
    "pilot:infra:down": "docker compose down",
    "pilot:worker:docker": "docker compose --profile pilot up -d --build worker",
    "pilot:setup": "node scripts/pilot-setup.mjs",
    "pilot:check": "node scripts/pilot-check.mjs",
    "deploy:smoke": "node scripts/deploy-smoke.mjs",
    "db:backup": "node scripts/backup-postgres.mjs",
    "db:restore": "node scripts/restore-postgres.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons:generate": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "@tanstack/react-query": "^5.104.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.52.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.6.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.511.0",
    "next": "^16.4.6",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
