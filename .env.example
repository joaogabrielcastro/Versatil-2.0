# =============================================================================
# Versátil Academia — variáveis de ambiente
# Copie para `.env` e ajuste os valores. Validação: `src/lib/env.ts`
# =============================================================================

NODE_ENV=development

# --- Obrigatórias -------------------------------------------------------------
DATABASE_URL=postgresql://app:app@localhost:5432/tecnofit
# Redis local via Compose: porta host 6380 → container 6379
REDIS_URL=redis://localhost:6380

# Segredos de sessão (≥ 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-jwt-secret-min-32-chars!!
# Legado do schema (não usa NextAuth); mantenha ≥ 32 chars
NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-ch

PORT=3000

# --- App / URLs ---------------------------------------------------------------
# URL pública (redirects Stripe, links absolutos)
APP_URL=http://localhost:3000

# Exibe credenciais demo na homepage (apenas desenvolvimento/demo)
SHOW_DEMO_CREDENTIALS=true

# --- Segurança operacional (recomendado em produção) --------------------------
# Bearer para GET /api/cron/* (≥ 8)
CRON_SECRET=change-me-cron-secret-16

# Bearer para POST /api/webhooks/gateway (≥ 16)
WEBHOOK_INGEST_SECRET=change-me-webhook-ingest-16

# Bearer para POST /api/webhooks/stone (≥ 16) — obrigatório quando Stone estiver ativo
STONE_WEBHOOK_SECRET=

# Token do terminal de treino (≥ 16). Em produção é obrigatório.
# URL do terminal: /imprimir-treino?slug=demo&token=SEU_TOKEN
KIOSK_ACCESS_SECRET=change-me-kiosk-token-16

# 64 hex chars (32 bytes) para cifrar credenciais Stripe por tenant
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_ENCRYPTION_KEY=

# --- Pagamentos (opcional) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Catraca / hardware (opcional) --------------------------------------------
TURNSTILE_PUSH_URL=

# --- Worker / runtime ---------------------------------------------------------
# true = não corre migrações no start (use no worker)
SKIP_MIGRATIONS=false

# --- Observabilidade (worker) -------------------------------------------------
OBSERVABILITY_SERVICE=versatil-worker
OBSERVABILITY_LOG_FORMAT=text
OBSERVABILITY_METRICS_INTERVAL_MS=60000
OBSERVABILITY_ALERT_WEBHOOK_URL=
OBSERVABILITY_ALERT_WEBHOOK_TOKEN=
# 0 = desligado; alerta se waiting > valor
OBSERVABILITY_ALERT_QUEUE_WAITING_THRESHOLD=0

# --- Scripts / smoke (opcional) -----------------------------------------------
# PILOT_BASE_URL=http://127.0.0.1:3000
# BACKUP_DIR=./backups
